# Copy to .env and fill in locally:  cp .env.example .env
# .env is git-ignored. Never commit real values.
# These variables are consumed from Phase 04 onwards (dbt profile, helper scripts).

# Databricks CLI profile for this project (name of the section in ~/.databrickscfg).
# Set it explicitly if you have other profiles, so commands never fall back to
# a default profile that points at a different workspace.
DATABRICKS_CONFIG_PROFILE=<project-profile-name>

# Workspace URL, no trailing slash.
DATABRICKS_HOST=https://<workspace-host>

# SQL warehouse HTTP path: SQL Warehouses > <warehouse> > Connection details.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Personal access token for dbt-databricks. Leave empty when using OAuth
# (databricks auth login). Treat any value here as a secret.
DATABRICKS_TOKEN=

# Unity Catalog catalog that holds the retail_* schemas (docs/adr/0002).
RETAIL_CATALOG=workspace
